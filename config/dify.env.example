# Dify Configuration
# Copy this to .env and fill in your values

# ============================================================
# LLM Configuration (Local deployment, OpenAI-compatible API)
# ============================================================
LLM_API_BASE=http://your-llm-host:8000/v1
LLM_API_KEY=your-llm-api-key
LLM_MODEL_NAME=your-model-name

# ============================================================
# Embedding Model (OpenAI-compatible API)
# ============================================================
EMBEDDING_API_BASE=http://your-embedding-host:8001/v1
EMBEDDING_API_KEY=your-embedding-api-key
EMBEDDING_MODEL_NAME=your-embedding-model

# ============================================================
# Rerank Model (OpenAI-compatible API)
# ============================================================
RERANK_API_BASE=http://your-rerank-host:8002/v1
RERANK_API_KEY=your-rerank-api-key
RERANK_MODEL_NAME=your-rerank-model

# ============================================================
# Qdrant Vector Database
# ============================================================
QDRANT_URL=http://your-qdrant-host:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=rdma_knowledge

# ============================================================
# Dify Platform
# ============================================================
DIFY_API_URL=http://your-dify-host/v1
DIFY_API_KEY=your-dify-workflow-api-key

# ============================================================
# RDMA Agent Tools Service
# ============================================================
AGENT_TOOLS_HOST=0.0.0.0
AGENT_TOOLS_PORT=5100
AGENT_TOOLS_API_KEY=your-agent-tools-api-key
# Set to true for testing without executing real commands
AGENT_TOOLS_DRY_RUN=false
